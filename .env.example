# Browser-exposed Google Maps JavaScript API key.
# This is NOT a secret once shipped to a browser. Protect it with HTTP referrer
# restrictions and API restrictions in Google Cloud Console.
GOOGLE_MAPS_API_KEY=replace_me

# Optional Cloud Map ID for cloud-based 3D styling.
GOOGLE_MAP_ID=

# Optional OpenSky OAuth client credentials. Leave blank for anonymous access.
# Keep these server-side only. Never expose them in web/runtime-config.js.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Local server only.
PORT=4173
